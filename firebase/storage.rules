rules_version = '2';

// Knowledge OS bijlagen — alleen de eigenaar mag lezen/schrijven
// onder zijn eigen uid-pad, en alleen als die uid op de
// allowedUsers-lijst staat (zelfde eis als de Firestore-rules).
service firebase.storage {
  match /b/{bucket}/o {
    match /knowledge-attachments/{uid}/{attachmentId}/{fileName} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && firestore.exists(/databases/(default)/documents/allowedUsers/$(uid));
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
